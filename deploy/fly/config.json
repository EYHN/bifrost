{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "auth_config": {
    "is_enabled": true,
    "admin_username": "env.BIFROST_ADMIN_USERNAME",
    "admin_password": "env.BIFROST_ADMIN_PASSWORD"
  },
  "client": {
    "enable_logging": true,
    "disable_content_logging": true
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "env.PG_PORT",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DB_NAME",
      "ssl_mode": "env.PG_SSL_MODE",
      "max_idle_conns": 5,
      "max_open_conns": 20
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "env.PG_PORT",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DB_NAME",
      "ssl_mode": "env.PG_SSL_MODE",
      "max_idle_conns": 5,
      "max_open_conns": 30
    },
    "retention_days": 30,
    "matview_refresh_interval": "5m"
  }
}
